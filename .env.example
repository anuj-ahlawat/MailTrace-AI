# Generate private local values with: backend/venv/bin/python scripts/setup.py
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=mailtrace_enterprise
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
EVIDENCE_ENCRYPTION_KEY=
WORKER_MODE=local
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
# Paths are relative to the repository root unless absolute.
# STORAGE_DIR=storage
# DATA_DIR=storage  # Legacy fallback; STORAGE_DIR takes precedence.
# MODEL_DIR=ml/artifacts/production
# DATASETS_DIR=data/datasets
# GEOIP_DIR=data/geoip
# EXPORT_DIR=storage/exports
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
# Local GeoLite2 database paths; City and ASN can be configured independently
GEOIP_CITY_DB=
GEOIP_ASN_DB=
# Docker always uses paths inside the mounted data/geoip directory.
# For versioned vendor bundles, set the relative bundle path inside /srv/data/geoip.
# DOCKER_GEOIP_CITY_DB=/srv/data/geoip/GeoLite2-City.mmdb
# DOCKER_GEOIP_ASN_DB=/srv/data/geoip/GeoLite2-ASN.mmdb
# Optional legacy compatibility only; not required by the local stack
URLSCAN_API_KEY=
GREYNOISE_API_KEY=
GEOIP_LICENSE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
# Docker credentials (setup.py generates these)
MONGO_ROOT_USER=mailtrace_root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=mailtrace
MONGO_APP_PASSWORD=
REDIS_PASSWORD=

# Optional neural inference libraries in backend/worker Docker images
INSTALL_DEEP=false

# IPinfo network intelligence (enable ipinfo + automatic_enrichment in Settings).
IPINFO_TOKEN=
# lookup: Core/Plus/Max; lite: country/ASN only; legacy: existing legacy plans.
IPINFO_API_MODE=lookup
