# Generate private local values with: backend/venv/bin/python scripts/setup.py
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=mailtrace_enterprise
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
EVIDENCE_ENCRYPTION_KEY=
WORKER_MODE=local
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
# Optional absolute paths; default to repository data and ml/artifacts/production
# DATA_DIR=
# MODEL_DIR=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
# Local GeoLite2 database paths; City and ASN can be configured independently
GEOIP_CITY_DB=
GEOIP_ASN_DB=
# Optional legacy compatibility only; not required by the local stack
URLSCAN_API_KEY=
GREYNOISE_API_KEY=
GEOIP_LICENSE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
# Docker credentials (setup.py generates these)
MONGO_ROOT_USER=mailtrace_root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=mailtrace
MONGO_APP_PASSWORD=
REDIS_PASSWORD=

# Optional neural inference libraries in backend/worker Docker images
INSTALL_DEEP=false
